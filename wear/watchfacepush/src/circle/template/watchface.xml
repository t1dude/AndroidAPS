<WatchFace clipShape="CIRCLE" height="450" width="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />

    <!-- The glucose circle face.

         The phone overview's BG circle sits large at the centre-left, three customizable complication
         slots run down the right edge following the curve of the screen, and a clock that cannot be
         removed sits on top, so the time is always there whatever the wearer puts in the slots.

         Watch Face Format cannot draw an arc that follows data, so the circle is a picture drawn by
         the wear app (GlucoseCircleComplication) in a slot the wearer cannot change. Its age line
         only moves when the picture is redrawn; GlucoseCircleUpdater asks for that each time the
         minute count changes.

         Always-on: our process is frozen while the watch dozes (see the cwf face), so the picture
         would sit there with an age that has stopped. It is hidden then, and the runtime draws a grey
         ring outline and the reading from a text complication whose age it keeps counting itself.
         The side slots are hidden too; only the clock and the reading remain.

         Children of a ComplicationSlot are positioned relative to the slot, as in the wfs face. -->

    <Scene backgroundColor="#ff000000">

        <!-- Fixed clock, awake and always-on. hourFormat follows the device's 12/24 hour setting. -->
        <DigitalClock x="105" y="20" width="240" height="64">
            <TimeText align="CENTER" format="hh:mm" hourFormat="SYNC_TO_DEVICE"
                x="0" y="0" width="240" height="64">
                <Font color="#ffffffff" family="SYNC_TO_DEVICE" size="52" slant="NORMAL" weight="NORMAL" />
            </TimeText>
        </DigitalClock>

        <!-- AM or PM, only on a 12-hour device: TimeText cannot draw it (see the cwf face). Beside
             the time rather than under it, where the circle leaves no room. -->
        <Condition>
            <Expressions>
                <Expression name="twelveHourClock">[IS_24_HOUR_MODE] == 0</Expression>
            </Expressions>
            <Compare expression="twelveHourClock">
                <PartText x="300" y="44" width="60" height="30">
                    <Text align="START" ellipsis="TRUE">
                        <Font color="#ffadadad" family="SYNC_TO_DEVICE" size="22" slant="NORMAL" weight="NORMAL">
                            <Template>%s<Parameter expression="[AMPM_STRING]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Compare>
        </Condition>

        <!-- Always-on ring outline, where the picture's ring is: the picture is 270 px wide and
             drawn at 150 overview dp, so the ring's centre line has a radius of 106 px. -->
        <PartDraw x="30" y="100" width="270" height="270" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <Ellipse x="29" y="29" width="212" height="212">
                <Stroke color="#ff6e6e6e" thickness="4" />
            </Ellipse>
        </PartDraw>

        <!-- The circle picture. Tapping it opens the BG graph. -->
        <ComplicationSlot
            name="GlucoseCircle"
            slotId="0"
            displayName="Glucose circle"
            isCustomizable="FALSE"
            supportedTypes="SMALL_IMAGE EMPTY"
            alpha="255"
            x="30" y="100" width="270" height="270">
            <DefaultProviderPolicy
                primaryProvider="AAPS_WEAR_APP_ID/app.aaps.wear.complications.circle.GlucoseCircleComplication"
                primaryProviderType="SMALL_IMAGE"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingOval x="0" y="0" width="270" height="270" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="270" height="270">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- The always-on reading inside the ring. Invisible while awake, but it still takes the
             taps over the circle then, so its provider opens the BG graph too - and nothing while
             dozing, so the first tap wakes the watch. -->
        <ComplicationSlot
            name="GlucoseCircleAmbient"
            slotId="1"
            displayName="Glucose circle always-on"
            isCustomizable="FALSE"
            supportedTypes="SHORT_TEXT EMPTY"
            alpha="0"
            x="30" y="100" width="270" height="270">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <DefaultProviderPolicy
                primaryProvider="AAPS_WEAR_APP_ID/app.aaps.wear.complications.circle.GlucoseCircleAmbientComplication"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingOval x="0" y="0" width="270" height="270" />
            <Complication type="SHORT_TEXT">
                <PartText x="20" y="84" width="230" height="74">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font color="#ffdcdcdc" family="SYNC_TO_DEVICE" size="62" slant="NORMAL" weight="NORMAL">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="40" y="158" width="190" height="36">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font color="#ffb4b4b4" family="SYNC_TO_DEVICE" size="28" slant="NORMAL" weight="NORMAL">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- The three slots on the right. Empty on top, the time and date in the middle, insulin on
             board at the bottom - whose tap opens the bolus screen. -->

        <ComplicationSlot
            name="SlotTop"
            slotId="2"
            displayName="@string/slot_top"
            isCustomizable="TRUE"
            supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY"
            alpha="255"
            x="300" y="94" width="96" height="96">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingOval x="0" y="0" width="96" height="96" />
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="96" height="96">
                    <Ellipse x="0" y="0" width="96" height="96">
                        <Fill color="#ff1e1e1e" />
                    </Ellipse>
                </PartDraw>
                <Condition>
                    <Expressions>
                        <Expression name="iconAndText"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                        <Expression name="titleAndText"><![CDATA[[COMPLICATION.TITLE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="iconAndText">
                        <PartImage x="32" y="12" width="32" height="32" tintColor="#ff67dfe8">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                        <PartText x="4" y="46" width="88" height="34">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="26" weight="NORMAL" slant="NORMAL" color="#ffffffff">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Compare expression="titleAndText">
                        <PartText x="4" y="18" width="88" height="36">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="28" weight="NORMAL" slant="NORMAL" color="#ffffffff">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                        <PartText x="8" y="54" width="80" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="20" weight="NORMAL" slant="NORMAL" color="#ffadadad">
                                    <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="4" y="30" width="88" height="36">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="30" weight="NORMAL" slant="NORMAL" color="#ffffffff">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartDraw x="0" y="0" width="96" height="96">
                    <Ellipse x="0" y="0" width="96" height="96">
                        <Fill color="#ff1e1e1e" />
                    </Ellipse>
                </PartDraw>
                <PartImage x="24" y="24" width="48" height="48" tintColor="#ff67dfe8">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="80" height="80">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot
            name="SlotMiddle"
            slotId="3"
            displayName="@string/slot_middle"
            isCustomizable="TRUE"
            supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY"
            alpha="255"
            x="324" y="187" width="96" height="96">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="TIME_AND_DATE"
                defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="96" height="96" />
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="96" height="96">
                    <Ellipse x="0" y="0" width="96" height="96">
                        <Fill color="#ff1e1e1e" />
                    </Ellipse>
                </PartDraw>
                <Condition>
                    <Expressions>
                        <Expression name="iconAndText"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                        <Expression name="titleAndText"><![CDATA[[COMPLICATION.TITLE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="iconAndText">
                        <PartImage x="32" y="12" width="32" height="32" tintColor="#ff67dfe8">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                        <PartText x="4" y="46" width="88" height="34">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="26" weight="NORMAL" slant="NORMAL" color="#ffffffff">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Compare expression="titleAndText">
                        <PartText x="4" y="18" width="88" height="36">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="28" weight="NORMAL" slant="NORMAL" color="#ffffffff">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                        <PartText x="8" y="54" width="80" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="20" weight="NORMAL" slant="NORMAL" color="#ffadadad">
                                    <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="4" y="30" width="88" height="36">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="30" weight="NORMAL" slant="NORMAL" color="#ffffffff">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartDraw x="0" y="0" width="96" height="96">
                    <Ellipse x="0" y="0" width="96" height="96">
                        <Fill color="#ff1e1e1e" />
                    </Ellipse>
                </PartDraw>
                <PartImage x="24" y="24" width="48" height="48" tintColor="#ff67dfe8">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="80" height="80">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot
            name="SlotBottom"
            slotId="4"
            displayName="@string/slot_bottom"
            isCustomizable="TRUE"
            supportedTypes="SHORT_TEXT MONOCHROMATIC_IMAGE SMALL_IMAGE EMPTY"
            alpha="255"
            x="300" y="280" width="96" height="96">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy
                primaryProvider="AAPS_WEAR_APP_ID/app.aaps.wear.complications.IobIconComplication"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingOval x="0" y="0" width="96" height="96" />
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="96" height="96">
                    <Ellipse x="0" y="0" width="96" height="96">
                        <Fill color="#ff1e1e1e" />
                    </Ellipse>
                </PartDraw>
                <Condition>
                    <Expressions>
                        <Expression name="iconAndText"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                        <Expression name="titleAndText"><![CDATA[[COMPLICATION.TITLE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="iconAndText">
                        <PartImage x="32" y="12" width="32" height="32" tintColor="#ff67dfe8">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                        <PartText x="4" y="46" width="88" height="34">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="26" weight="NORMAL" slant="NORMAL" color="#ffffffff">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Compare expression="titleAndText">
                        <PartText x="4" y="18" width="88" height="36">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="28" weight="NORMAL" slant="NORMAL" color="#ffffffff">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                        <PartText x="8" y="54" width="80" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="20" weight="NORMAL" slant="NORMAL" color="#ffadadad">
                                    <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="4" y="30" width="88" height="36">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="30" weight="NORMAL" slant="NORMAL" color="#ffffffff">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartDraw x="0" y="0" width="96" height="96">
                    <Ellipse x="0" y="0" width="96" height="96">
                        <Fill color="#ff1e1e1e" />
                    </Ellipse>
                </PartDraw>
                <PartImage x="24" y="24" width="48" height="48" tintColor="#ff67dfe8">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="8" y="8" width="80" height="80">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

    </Scene>
</WatchFace>
