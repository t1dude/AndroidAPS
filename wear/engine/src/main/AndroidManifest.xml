<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The keep alive's alarm holds the watch awake for one run (EngineKeepAlive) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- Handover: the Medtrum patch session the phone handed over -->
        <activity
            android:name=".medtrum.MedtrumWatchActivity"
            android:exported="false"
            android:taskAffinity="" />
        <!-- The engine's keep alive when no CGM reading comes (EngineKeepAlive) -->
        <receiver
            android:name=".EngineKeepAliveReceiver"
            android:exported="false" />
        <receiver
            android:name=".receivers.CarbSuggestionReceiver"
            android:exported="false" />
        <receiver
            android:name=".EngineRestartReceiver"
            android:exported="false" />
    </application>

</manifest>
